@model AdminCategoryViewModel
@{
    ViewData["Title"] = Localizer[Model.Id is null ? "Admin_Cat_New" : "Admin_Cat_Edit"].Value;
}

<p><a class="link" asp-action="Index">← @Localizer["Admin_Nav_Categories"]</a></p>
<h1 class="admin-title">@ViewData["Title"]</h1>

<form method="post" asp-action="Edit" enctype="multipart/form-data" class="form admin-narrow">
    <div asp-validation-summary="ModelOnly" class="alert alert--error"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ImagePath" />

    <section class="panel">
        <div class="admin-fields">
            <div class="field">
                <label asp-for="NameHy" class="field__label"></label>
                <input asp-for="NameHy" class="input" maxlength="100" required />
                <span asp-validation-for="NameHy" class="field__error"></span>
            </div>
            <div class="field">
                <label asp-for="NameRu" class="field__label"></label>
                <input asp-for="NameRu" class="input" maxlength="100" />
                <span asp-validation-for="NameRu" class="field__error"></span>
            </div>
            <div class="field">
                <label asp-for="NameEn" class="field__label"></label>
                <input asp-for="NameEn" class="input" maxlength="100" />
                <span asp-validation-for="NameEn" class="field__error"></span>
            </div>
            <div class="field">
                <label asp-for="SortOrder" class="field__label"></label>
                <input asp-for="SortOrder" class="input" type="number" min="0" max="1000" step="1" required />
                <span asp-validation-for="SortOrder" class="field__error"></span>
            </div>
        </div>
        <p class="admin-hint">@Localizer["Admin_Name_Hint"]</p>

        <label class="check">
            <input asp-for="IsActive" type="checkbox" />
            <span>@Localizer["Admin_Cat_Active"]</span>
        </label>
    </section>

    <section class="panel">
        <h2 class="admin-h2">@Localizer["Admin_Picture"]</h2>
        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <p><img class="admin-preview" src="@Model.ImagePath" alt="" width="120" height="120" /></p>
        }
        <div class="field">
            <input asp-for="Image" type="file" class="input" accept="image/jpeg,image/png,image/webp" />
            <span asp-validation-for="Image" class="field__error"></span>
        </div>
        <p class="admin-hint">@Localizer["Admin_Img_Hint"]</p>
    </section>

    <button type="submit" class="btn btn--primary">@Localizer["Admin_Save"]</button>
</form>
