@using System.Globalization
@model AdminReturnsViewModel
@{
    ViewData["Title"] = Localizer["Admin_Nav_Returns"].Value;
}

<h1 class="admin-title">@Localizer["Admin_Nav_Returns"]</h1>

<nav class="admin-tabs" aria-label="@Localizer["Admin_Status"].Value">
    <a class="chip @(Model.Status is null ? "is-active" : "")" asp-action="Index">@Localizer["Admin_AllStatuses"]</a>
    @foreach (var status in Enum.GetValues<ReturnStatus>())
    {
        <a class="chip @(Model.Status == status ? "is-active" : "")" asp-action="Index" asp-route-status="@status">@Localizer["Return_" + status]</a>
    }
</nav>

@if (Model.Result.Items.Count == 0)
{
    <p class="admin-empty">@Localizer["Admin_NoResults"]</p>
}
else
{
    <table class="atable">
        <thead>
            <tr>
                <th>@Localizer["Admin_Col_Order"]</th>
                <th>@Localizer["Admin_Col_Date"]</th>
                <th>@Localizer["Admin_Col_Customer"]</th>
                <th>@Localizer["Admin_Col_Status"]</th>
                <th>@Localizer["Admin_Ret_Reason"]</th>
                <th class="atable__num">@Localizer["Admin_Col_Total"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Result.Items)
            {
                <tr>
                    <td data-label="@Localizer["Admin_Col_Order"].Value"><a class="link" asp-action="Details" asp-route-id="@row.Id"><strong>#@row.OrderNumber</strong></a></td>
                    <td data-label="@Localizer["Admin_Col_Date"].Value">@ShopClock.ToShopTime(row.CreatedAt).ToString("d MMM yyyy, HH:mm", CultureInfo.CurrentCulture)</td>
                    <td data-label="@Localizer["Admin_Col_Customer"].Value">@row.CustomerName</td>
                    <td data-label="@Localizer["Admin_Col_Status"].Value"><span class="flag @(row.Status == ReturnStatus.Requested ? "flag--alert" : "")">@Localizer["Return_" + row.Status]</span></td>
                    <td data-label="@Localizer["Admin_Ret_Reason"].Value" class="admin-reason">@row.Reason</td>
                    <td class="atable__num" data-label="@Localizer["Admin_Col_Total"].Value">@Money.Format(row.OrderTotal)</td>
                </tr>
            }
        </tbody>
    </table>

    <partial name="_Pager" model="(Model.Result.Page, Model.Result.TotalPages)" />
}
