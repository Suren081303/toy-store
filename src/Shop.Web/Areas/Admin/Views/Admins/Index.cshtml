@using System.Globalization
@model AdminAccountsViewModel
@{
    ViewData["Title"] = Localizer["Admin_Nav_Admins"].Value;
}

<div class="admin-toolbar">
    <h1 class="admin-title">@Localizer["Admin_Nav_Admins"]</h1>
    <a class="btn btn--primary" asp-action="Create">@Localizer["Admin_Adm_New"]</a>
</div>
<p class="admin-hint">@Localizer["Admin_Adm_Hint"]</p>

<table class="atable">
    <thead>
        <tr>
            <th>@Localizer["Admin_Adm_Email"]</th>
            <th>@Localizer["Admin_Adm_Name"]</th>
            <th>@Localizer["Admin_Adm_Phone"]</th>
            <th>@Localizer["Admin_Adm_Since"]</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var admin in Model.Admins)
        {
            var isYou = admin.Id == Model.CurrentAdminId;
            <tr>
                <td data-label="@Localizer["Admin_Adm_Email"].Value">
                    <strong>@admin.Email</strong>
                    @if (isYou)
                    {
                        <span class="flag">@Localizer["Admin_Adm_You"]</span>
                    }
                    @if (admin.IsConfigured)
                    {
                        <span class="flag">@Localizer["Admin_Adm_Main"]</span>
                    }
                </td>
                <td data-label="@Localizer["Admin_Adm_Name"].Value">@admin.FullName</td>
                <td data-label="@Localizer["Admin_Adm_Phone"].Value">@admin.Phone</td>
                <td data-label="@Localizer["Admin_Adm_Since"].Value">@ShopClock.ToShopTime(admin.CreatedAt).ToString("d MMM yyyy", CultureInfo.CurrentCulture)</td>
                <td class="atable__actions">
                    <a class="btn btn--ghost btn--small" asp-action="Edit" asp-route-id="@admin.Id">@Localizer["Admin_Edit"]</a>
                    @if (!admin.IsConfigured)
                    {
                        <form method="post" asp-action="Delete">
                            <input type="hidden" name="id" value="@admin.Id" />
                            <button type="submit" class="btn btn--danger btn--small"
                                    data-confirm="@Localizer.GetString(isYou ? "Admin_Adm_ConfirmDeleteSelf" : "Admin_Adm_ConfirmDelete", admin.Email).Value">@Localizer["Admin_Adm_Delete"]</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
<p class="admin-hint">@Localizer["Admin_Adm_MainHint"]</p>
