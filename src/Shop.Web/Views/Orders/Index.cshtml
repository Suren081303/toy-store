@using System.Globalization
@using Shop.Core.Orders
@model IReadOnlyList<OrderListItem>
@{
    ViewData["Title"] = Localizer["Nav_Orders"].Value;
}

<section class="container auth auth--wide">
    <partial name="_AccountNav" model='"Orders"' />

    <h1 class="page-title">@Localizer["Nav_Orders"]</h1>

    @if (Model.Count == 0)
    {
        <div class="auth__card auth__card--center">
            <p class="auth__lead">@Localizer["Orders_Empty"]</p>
            <a class="btn btn--primary" asp-controller="Products" asp-action="Index">@Localizer["ShopNow"]</a>
        </div>
    }
    else
    {
        <ul class="order-list">
            @foreach (var order in Model)
            {
                <li>
                    <a class="order-card" asp-controller="Orders" asp-action="Details" asp-route-number="@order.Number">
                        <span class="order-card__top">
                            <strong>@Localizer["Order_Number"] #@order.Number</strong>
                            <span class="status status--@order.Status.ToString().ToLowerInvariant()">@Localizer["Status_" + order.Status]</span>
                        </span>
                        <span class="order-card__bottom">
                            <span>@ShopClock.ToShopTime(order.CreatedAt).ToString("d MMM yyyy", CultureInfo.CurrentCulture) · @Localizer["Items" + Plurals.GetForm(CurrentCulture.Code, order.ItemCount), order.ItemCount]</span>
                            <strong>@Money.Format(order.Total)</strong>
                        </span>
                    </a>
                </li>
            }
        </ul>
    }
</section>
