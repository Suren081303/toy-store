@model IReadOnlyList<ProductListItem>
@{
    ViewData["Title"] = Localizer["Nav_Favorites"].Value;
    var signedIn = User.Identity?.IsAuthenticated == true;
}

<section class="container auth auth--wide" data-favorites-page>
    @if (signedIn)
    {
        <partial name="_AccountNav" model='"Favorites"' />
    }

    <h1 class="page-title">@Localizer["Nav_Favorites"]</h1>

    @if (!signedIn)
    {
        <p class="alert alert--info">
            @Localizer["Fav_GuestHint"]
            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">@Localizer["Nav_SignIn"]</a>
        </p>
    }

    @if (Model.Count == 0)
    {
        <div class="auth__card auth__card--center">
            <p class="auth__lead">@Localizer["Favorites_Empty"]</p>
            <a class="btn btn--primary" asp-controller="Products" asp-action="Index">@Localizer["ShopNow"]</a>
        </div>
    }
    else
    {
        <div class="product-grid">
            @foreach (var product in Model)
            {
                <partial name="_ProductCard" model="product" />
            }
        </div>
    }
</section>
