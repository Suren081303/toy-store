@model ChangePasswordViewModel
@{
    ViewData["Title"] = Localizer["Nav_ChangePassword"].Value;
}

<section class="container auth auth--wide">
    <partial name="_AccountNav" model='"Password"' />

    <div class="auth__card">
        <h1 class="page-title">@Localizer["Nav_ChangePassword"]</h1>

        @if (TempData["Saved"] is true)
        {
            <p class="alert alert--success" role="status">@Localizer["Account_Saved"]</p>
        }

        <form method="post" class="form" asp-controller="Account" asp-action="ChangePassword">
            <div asp-validation-summary="ModelOnly" class="alert alert--error"></div>

            <div class="field">
                <label asp-for="CurrentPassword" class="field__label"></label>
                <div class="pw">
                    <input asp-for="CurrentPassword" class="input" autocomplete="current-password" required maxlength="100" />
                    <button type="button" class="pw__toggle" data-toggle-password aria-pressed="false" aria-label="@Localizer["Show_Password"].Value">
                        <svg class="icon" aria-hidden="true"><use href="#i-eye" /></svg>
                    </button>
                </div>
                <span asp-validation-for="CurrentPassword" class="field__error"></span>
            </div>

            <div class="field">
                <label asp-for="NewPassword" class="field__label"></label>
                <div class="pw">
                    <input asp-for="NewPassword" class="input" autocomplete="new-password" required minlength="8" maxlength="100" />
                    <button type="button" class="pw__toggle" data-toggle-password aria-pressed="false" aria-label="@Localizer["Show_Password"].Value">
                        <svg class="icon" aria-hidden="true"><use href="#i-eye" /></svg>
                    </button>
                </div>
                <span asp-validation-for="NewPassword" class="field__error"></span>
                <p class="field__hint">@Localizer["Hint_Password"]</p>
            </div>

            <button type="submit" class="btn btn--primary btn--lg btn--block">@Localizer["ChangePassword_Submit"]</button>
        </form>
    </div>
</section>
