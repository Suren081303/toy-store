@model EmailOnlyViewModel
@{
    ViewData["Title"] = Localizer["Forgot_Title"].Value;
}

<section class="container auth">
    <div class="auth__card">
        <h1 class="page-title">@Localizer["Forgot_Title"]</h1>
        <p class="auth__lead">@Localizer["Forgot_Lead"]</p>

        <form method="post" class="form" asp-controller="Account" asp-action="ForgotPassword">
            <div asp-validation-summary="ModelOnly" class="alert alert--error"></div>

            <div class="field">
                <label asp-for="Email" class="field__label"></label>
                <input asp-for="Email" class="input" type="email" autocomplete="email" inputmode="email" autocapitalize="none" required maxlength="256" />
                <span asp-validation-for="Email" class="field__error"></span>
            </div>

            <button type="submit" class="btn btn--primary btn--lg btn--block">@Localizer["Forgot_Submit"]</button>
        </form>

        <p class="auth__switch"><a asp-action="Login">@Localizer["Nav_SignIn"]</a></p>
    </div>
</section>
