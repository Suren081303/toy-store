@model ResetPasswordViewModel
@{
    ViewData["Title"] = Localizer["Reset_Title"].Value;
}

<section class="container auth">
    <div class="auth__card">
        <h1 class="page-title">@Localizer["Reset_Title"]</h1>

        <form method="post" class="form" asp-controller="Account" asp-action="ResetPassword">
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />
            <div asp-validation-summary="ModelOnly" class="alert alert--error"></div>

            <div class="field">
                <label asp-for="Password" class="field__label"></label>
                <div class="pw">
                    <input asp-for="Password" class="input" autocomplete="new-password" required minlength="8" maxlength="100" />
                    <button type="button" class="pw__toggle" data-toggle-password aria-pressed="false" aria-label="@Localizer["Show_Password"].Value">
                        <svg class="icon" aria-hidden="true"><use href="#i-eye" /></svg>
                    </button>
                </div>
                <span asp-validation-for="Password" class="field__error"></span>
                <p class="field__hint">@Localizer["Hint_Password"]</p>
            </div>

            <button type="submit" class="btn btn--primary btn--lg btn--block">@Localizer["Reset_Submit"]</button>
        </form>
    </div>
</section>
