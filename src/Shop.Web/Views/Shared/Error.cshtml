@model ErrorViewModel
@* The error page stands alone (no shop layout): the layout reads the database, and the database may be the thing that failed. *@
@{
    Layout = null;
    var culture = CurrentCulture.Code;
    var shopName = Configuration["Shop:Name"];
}
<!DOCTYPE html>
<html lang="@culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#6544a3" />
    <title>@Localizer["Msg_ErrorTitle"] - @shopName</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages.css" asp-append-version="true" />
</head>
<body>
    <main id="main" class="container notice">
        <p class="notice__code" aria-hidden="true">500</p>
        <h1 class="page-title">@Localizer["Msg_ErrorTitle"]</h1>
        <p class="notice__text">@Localizer["Msg_ErrorText"]</p>
        <a class="btn btn--primary" href="/@culture">@Localizer["BackToHome"]</a>
        @if (Model.ShowRequestId)
        {
            <p class="notice__text"><small>@Localizer["Error_Reference"]: <code>@Model.RequestId</code></small></p>
        }
    </main>
</body>
</html>
